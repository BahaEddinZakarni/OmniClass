rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default deny all collections
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Secured User Profiles and Classes State matching UserData Schema
    match /users/{userId} {
      // Allow read and write ONLY if the user is signed in and accessing their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
